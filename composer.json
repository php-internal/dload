{
    "name": "internal/dload",
    "description": "Downloads binaries.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "downloader",
        "download binaries"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/semver": "^3.4",
        "internal/container": "^1.0",
        "internal/destroy": "^1.0",
        "internal/path": "^1.2",
        "internal/toml": "^1.0.3",
        "nyholm/psr7": "^1.8",
        "psr/container": "1 - 2",
        "psr/http-client": "^1.0",
        "react/async": "^3.2 || ^4.3",
        "react/promise": "^2.10 || ^3.2",
        "symfony/console": "^6.4 || ^7 || ^8",
        "symfony/http-client": "^6.4 || ^7 || ^8"
    },
    "require-dev": {
        "buggregator/trap": "^1.15",
        "dereuromark/composer-prefer-lowest": "^0.1.10",
        "llm/skills": "^1.9",
        "roxblnfk/unpoly": "^1.8.1",
        "spiral/code-style": "^2.3.1",
        "testo/bridge-mockery": "^0.1.2",
        "testo/bridge-rector": "^0.2.4",
        "testo/testo": "^0.10.46",
        "vimeo/psalm": "^6.10 || ^7.0"
    },
    "suggest": {
        "ext-simplexml": "to support XML configs parsing"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Internal\\DLoad\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Internal\\DLoad\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/dload"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "llm/skills": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "extra": {
        "skills": {
            "source": "skills"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "infect": [
            "@putenv XDEBUG_MODE=coverage",
            "roave-infection-static-analysis-plugin --configuration=infection.json.dist"
        ],
        "infect:ci": [
            "@putenv XDEBUG_MODE=coverage",
            "roave-infection-static-analysis-plugin --ansi --configuration=infection.json.dist --logger-github --ignore-msi-with-no-mutations --only-covered"
        ],
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "refactor": "rector process --config=rector.php",
        "refactor:ci": "rector process --config=rector.php --dry-run --ansi",
        "test": [
            "testo --ansi --no-coverage"
        ],
        "test:unit": [
            "testo --ansi --no-coverage --suite=Unit"
        ],
        "test:integration": [
            "testo --ansi --no-coverage --suite=Integration"
        ],
        "test:acc": [
            "testo --ansi --no-coverage --suite=Acceptance"
        ],
        "test:cc": [
            "@putenv XDEBUG_MODE=coverage",
            "testo --ansi --coverage-clover=runtime/coverage/clover.xml"
        ]
    }
}
