{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DLoad Software Collection",
  "description": "Collection of software packages that can be downloaded through DLoad",
  "type": "object",
  "required": ["software"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "software": {
      "type": "array",
      "description": "List of software packages",
      "items": {
        "type": "object",
        "required": [
          "name",
          "repositories"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Software package name"
          },
          "alias": {
            "type": "string",
            "description": "CLI command alias"
          },
          "description": {
            "type": "string",
            "description": "Short description of the software"
          },
          "homepage": {
            "type": "string",
            "description": "Official software homepage URL"
          },
          "binary": {
            "type": "object",
            "description": "Binary executable definition",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Binary executable name: a file name, not a path"
              },
              "pattern": {
                "type": "string",
                "description": "Regular expression pattern to match binary file during extraction"
              },
              "version-command": {
                "type": "string",
                "description": "Arguments to check the binary version (e.g. '--version'), separated by spaces and passed without a shell"
              }
            }
          },
          "repositories": {
            "type": "array",
            "description": "List of repositories where the software can be found",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "uri"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Repository type identifier",
                  "default": "github"
                },
                "uri": {
                  "type": "string",
                  "description": "Repository path on the public host, like `owner/repo`, or a URL with a scheme for a self-hosted server, like `https://ghe.example.com/owner/repo`"
                },
                "asset-pattern": {
                  "type": "string",
                  "description": "Regular expression pattern to match assets"
                },
                "tag-prefix": {
                  "type": "string",
                  "description": "Text before the version in release tags, like `bun-` in `bun-v1.4.2`. Releases whose tag does not start with it are ignored, which selects one component of a monorepo (release-please style tags)."
                }
              }
            }
          },
          "files": {
            "type": "array",
            "description": "List of files to be extracted after download",
            "items": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string",
                  "description": "Regular expression pattern to match files",
                  "default": "/^.*$/"
                },
                "rename": {
                  "type": "string",
                  "description": "Rename found file to this value with the same extension"
                },
                "extract-path": {
                  "type": "string",
                  "description": "Directory where to extract files"
                }
              }
            }
          }
        }
      }
    }
  }
}